{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "S-notes: source app (.venv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "env": {
                "HOME": "${env:TMPDIR}/s-notes-vscode-home"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
