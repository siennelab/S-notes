[Unit]
Description=Back up the S-notes Reminder production database
After=snotes-reminder-api.service

[Service]
Type=oneshot
User=snotes
Group=snotes
WorkingDirectory=/srv/snotes/reminder-runtime
Environment=HOME=/srv/snotes
Environment=TZ=Asia/Shanghai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/snotes/runtime/.venv/bin/python -B -m src.reminder_cloud backup --database /srv/snotes/data/reminder-production.db --backup-directory /srv/snotes/backups/reminder-production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/snotes/data /srv/snotes/backups/reminder-production
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
