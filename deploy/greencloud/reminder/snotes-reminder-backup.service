[Unit]
Description=Back up the S-notes Reminder staging database
After=snotes-reminder-api.service

[Service]
Type=oneshot
User=snotes
Group=snotes
WorkingDirectory=/srv/snotes/reminder-runtime
Environment=HOME=/srv/snotes
Environment=TZ=Asia/Shanghai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/snotes/runtime/.venv/bin/python -B -m src.reminder_cloud backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/snotes/data /srv/snotes/backups/reminder
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
