# Template for /etc/snotes-gale-mcp-oidc-staging/service.env.
# The installed file must be root:root mode 0600. Replace placeholders only
# with sudoedit on the target host. Never commit the completed file or copy its
# values into shell history, logs, reports, backups filenames, or ChatGPT.
#
# These values describe the current accepted staging layout. They do not turn
# 8877 into a production service and they do not authorize real S-notes data.

# Read-only Gale mirror shared with the 8767 rollback service.
SNOTES_GALE_MIRROR_ROOT=/var/lib/snotes-gale-mcp/mirror
SNOTES_GALE_MIRROR_PATH=/var/lib/snotes-gale-mcp/mirror/gale-mirror.db
SNOTES_GALE_EXPECTED_OWNER_UID=REPLACE_WITH_SNOTES_GALE_NUMERIC_UID

# The backend must remain loopback-only.
SNOTES_GALE_HOST=127.0.0.1
SNOTES_GALE_PORT=8877
SNOTES_GALE_RESOURCE_URL=https://snotes.ke-den.de/mcp
SNOTES_GALE_AUDIENCE=https://snotes.ke-den.de/mcp
SNOTES_GALE_PROXY_BASE_URL=https://snotes.ke-den.de

# Upstream Auth0 tenant and pre-registered Regular Web Application.
SNOTES_GALE_ISSUER_URL=https://AUTH0_TENANT_DOMAIN/
SNOTES_GALE_JWKS_URL=https://AUTH0_TENANT_DOMAIN/.well-known/jwks.json
SNOTES_GALE_AUTH0_CONFIG_URL=https://AUTH0_TENANT_DOMAIN/.well-known/openid-configuration
SNOTES_GALE_AUTH0_CLIENT_ID=REPLACE_WITH_UPSTREAM_CLIENT_ID
SNOTES_GALE_AUTH0_CLIENT_SECRET=REPLACE_WITH_UPSTREAM_CLIENT_SECRET
SNOTES_GALE_ALLOWED_SUBJECTS=REPLACE_WITH_EXACT_ALLOWED_SUBJECT

# Encrypted downstream client, authorization, and token state.
SNOTES_GALE_OAUTH_STORAGE_DIR=/var/lib/snotes-gale-mcp-oidc-staging/oauth
SNOTES_GALE_STORAGE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SNOTES_GALE_PROXY_JWT_SIGNING_KEY=REPLACE_WITH_INDEPENDENT_SIGNING_KEY

# Comma-separated exact approved downstream redirect URI patterns.
# ChatGPT entries must contain the exact Draft ID. Never use
# https://chatgpt.com/* or another broad remote wildcard.
# Inspector loopback is a downstream redirect; it is not the upstream Auth0
# callback. Remove any client pattern that is not part of the approved test.
SNOTES_GALE_ALLOWED_CLIENT_REDIRECT_URIS=https://chatgpt.com/connector/oauth/<exact-draft-id>,http://127.0.0.1:*

# Fixed behavior, intentionally not configurable through service.env:
# - upstream Auth0 callback: https://snotes.ke-den.de/auth/callback
# - runtime business scope: gale.read
# - upstream OIDC request scopes: openid offline_access gale.read
# offline_access supports the proxy refresh flow; it is not a runtime business
# scope and must not appear in the search_notes/get_note security schemes.
#
# Permissions:
# - /etc/snotes-gale-mcp-oidc-staging/service.env: root:root 0600
# - /var/lib/snotes-gale-mcp-oidc-staging/oauth: snotes-gale:snotes-gale 0700
# - files created below the OAuth directory: 0600 (service UMask 0077)
