# Root-owned 0600 file. Do not add a client secret, access token, refresh
# token, authorization code, or any note content.
SNOTES_GALE_MIRROR_ROOT=/var/lib/snotes-gale-mcp/mirror
SNOTES_GALE_MIRROR_PATH=/var/lib/snotes-gale-mcp/mirror/gale-mirror.db
SNOTES_GALE_HOST=127.0.0.1
SNOTES_GALE_PORT=8767
SNOTES_GALE_RESOURCE_URL=https://snotes.ke-den.de/mcp
SNOTES_GALE_AUDIENCE=https://snotes.ke-den.de/mcp
SNOTES_GALE_ISSUER_URL=https://AUTH0_TENANT_DOMAIN/
SNOTES_GALE_JWKS_URL=https://AUTH0_TENANT_DOMAIN/.well-known/jwks.json
SNOTES_GALE_ALLOWED_SUBJECTS=AUTH0_USER_SUBJECT
SNOTES_GALE_EXPECTED_OWNER_UID=SNOTES_GALE_UID
