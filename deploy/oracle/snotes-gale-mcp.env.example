# Root-owned 0600 file. Replace secret placeholders only with sudoedit on the
# target host. Never place the completed file in Git, shell history, logs, or
# reports. Access tokens, refresh tokens, authorization codes, and note content
# do not belong here.
SNOTES_GALE_MIRROR_ROOT=/var/lib/snotes-gale-mcp/mirror
SNOTES_GALE_MIRROR_PATH=/var/lib/snotes-gale-mcp/mirror/gale-mirror.db
SNOTES_GALE_HOST=127.0.0.1
SNOTES_GALE_PORT=8767
SNOTES_GALE_RESOURCE_URL=https://snotes.ke-den.de/mcp
SNOTES_GALE_AUDIENCE=https://snotes.ke-den.de/mcp
SNOTES_GALE_ISSUER_URL=https://AUTH0_TENANT_DOMAIN/
SNOTES_GALE_JWKS_URL=https://AUTH0_TENANT_DOMAIN/.well-known/jwks.json
SNOTES_GALE_ALLOWED_SUBJECTS=AUTH0_USER_SUBJECT
SNOTES_GALE_EXPECTED_OWNER_UID=SNOTES_GALE_UID
SNOTES_GALE_AUTH0_CONFIG_URL=https://AUTH0_TENANT_DOMAIN/.well-known/openid-configuration
SNOTES_GALE_AUTH0_CLIENT_ID=***SET_WITH_SUDOEDIT***
SNOTES_GALE_AUTH0_CLIENT_SECRET=***SET_WITH_SUDOEDIT***
SNOTES_GALE_PROXY_BASE_URL=https://snotes.ke-den.de
SNOTES_GALE_OAUTH_STORAGE_DIR=/var/lib/snotes-gale-mcp/oauth
SNOTES_GALE_STORAGE_ENCRYPTION_KEY=***SET_WITH_SUDOEDIT***
SNOTES_GALE_PROXY_JWT_SIGNING_KEY=***SET_WITH_SUDOEDIT***
# Comma-separated exact/wildcard callback patterns. Keep only explicitly
# approved MCP clients. Inspector loopback is sufficient before staging.
SNOTES_GALE_ALLOWED_CLIENT_REDIRECT_URIS=http://127.0.0.1:*
